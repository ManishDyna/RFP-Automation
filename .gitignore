# Python virtualenv (stays at repo root)
env

# Python caches
__pycache__
_pycache_
.cache

# Backend secrets (never committed)
backend/config/config.py

# Backend runtime data & logs (outputs; some seed files under these are force-tracked)
backend/ALLRFPs
backend/ALLRFPs_old
backend/LOGS
backend/logs

# Guard against accidental npm installs at the repo root (frontend has its own package.json)
/node_modules
/package-lock.json
/package.json
